# ==============================================================================
# GELU - MENU & BACKOFFICE | CONFIGURAÇÃO DE AMBIENTE (.env)
# ==============================================================================
# Instruções:
# 1. Copie este arquivo para ".env" na mesma pasta raiz:
#    cp .env.example .env (ou no Windows: copy .env.example .env)
# 2. Ajuste as senhas e chaves conforme seu ambiente antes de subir o Docker.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOVERNANÇA & SUPER ADMIN (BACKOFFICE DEDICADO)
# ------------------------------------------------------------------------------
# E-mail e senha da conta mestre do Backoffice (http://localhost:3001).
# O Spring Boot sincroniza e atualiza automaticamente o hash da senha no banco ao iniciar.
GELU_SUPER_ADMIN_EMAIL=luanvitors_852@hotmail.com
GELU_SUPER_ADMIN_PASSWORD=MudeSuaSenhaAdmin123!

# Porta host para acesso ao console de administração e governança
BACKOFFICE_PORT=3001


# ------------------------------------------------------------------------------
# 2. INTELIGÊNCIA ARTIFICIAL (GOOGLE GEMINI)
# ------------------------------------------------------------------------------
# Chave de API do Google AI Studio (Free Tier: 15 req/min, 1M tokens/dia).
# Pode ser configurada aqui ou em tempo real direto pela aba de IA no Backoffice.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash


# ------------------------------------------------------------------------------
# 3. APLICAÇÕES WEB & ROTEAMENTO (PORTAS & URLs)
# ------------------------------------------------------------------------------
# Porta host do portal das famílias e usuários (cardápios, receitas, treinos)
FRONTEND_PORT=3000

# Porta host da API REST Spring Boot
BACKEND_PORT=8080

# URL pública que os navegadores usam para conversar com a API
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1


# ------------------------------------------------------------------------------
# 4. SEGURANÇA, AUTENTICAÇÃO & TOKENS (JWT)
# ------------------------------------------------------------------------------
# Segredo criptográfico para assinatura dos tokens JWT (use uma string longa e aleatória em produção)
JWT_SECRET=gelu-menu-local-development-secret-change-me

# Tempos de vida dos tokens de acesso e renovação
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d

# Recuperação de senha
# (true: retorna o token no JSON da resposta para testes locais fáceis sem SMTP)
EXPOSE_PASSWORD_RESET_TOKEN=true
PASSWORD_RESET_TOKEN_TTL=30m


# ------------------------------------------------------------------------------
# 5. BANCO DE DADOS (POSTGRESQL)
# ------------------------------------------------------------------------------
POSTGRES_DB=gelu_menu
POSTGRES_USER=gelu_menu
POSTGRES_PASSWORD=gelu_menu
POSTGRES_PORT=5432


# ------------------------------------------------------------------------------
# 6. ARMAZENAMENTO DE ARQUIVOS & MÍDIAS (MINIO / S3)
# ------------------------------------------------------------------------------
# Credenciais root do MinIO (compatível com Amazon S3)
MINIO_ROOT_USER=gelu_menu
MINIO_ROOT_PASSWORD=gelu_menu123

# Portas do serviço MinIO: 9000 (API S3) e 9001 (Console Web visual do MinIO)
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Nome do bucket de fotos e vídeos de receitas
STORAGE_BUCKET=gelu-menu-media

# Limite máximo de bytes por imagem (5242880 = 5MB)
STORAGE_MAX_IMAGE_SIZE_BYTES=5242880


# ------------------------------------------------------------------------------
# 7. LIMITES DE UPLOAD NO BACKEND (SPRING BOOT)
# ------------------------------------------------------------------------------
MEDIA_MAX_FILE_SIZE=5MB
MEDIA_MAX_REQUEST_SIZE=6MB
